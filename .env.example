# Copy to .env and adjust. Every setting can also be an environment variable.

ENVIRONMENT=development

# PostgreSQL (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://loan:loan@localhost:5432/loan_api

# Secrets: use long random values, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
OTP_SECRET=change-me-too
ADMIN_API_KEY=change-me-admin

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# SMS codes
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=5
# true = the code is returned in the API response (testing without SMS).
# Must be false when ENVIRONMENT=production.
EXPOSE_OTP_IN_RESPONSE=true

TIMEZONE=Asia/Baku
CURRENCY=AZN
MAX_PENDING_APPLICATIONS=3

# Admin panel
ADMIN_TOKEN_MINUTES=480
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCK_MINUTES=15
ADMIN_MIN_PASSWORD_LENGTH=10
# Largest uploaded document (stored in the database)
MAX_UPLOAD_MB=15

# JSON list. Production: the admin panel address, e.g. ["http://192.168.2.93:8090"]
CORS_ORIGINS=["*"]
